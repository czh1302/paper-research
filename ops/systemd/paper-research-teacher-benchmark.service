[Unit]
Description=Research Atlas six-paper teacher benchmark supervisor
Documentation=https://github.com/czh1302/paper-research
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/czh/SJTU_Task_final
EnvironmentFile=/home/czh/.config/paper-research/secrets.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/czh/SJTU_Task_final/.venv/bin/python -m paper_research.main benchmark-evaluate-v2 --manifest benchmark/teacher_benchmark_v1.json --concurrency 4 --output .artifacts/benchmark/teacher-v1
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2 3
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
