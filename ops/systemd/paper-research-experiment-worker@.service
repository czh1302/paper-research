[Unit]
Description=Research Atlas isolated Idea experiment worker %i of 8
Documentation=https://github.com/czh1302/paper-research
Wants=network-online.target
After=network-online.target paper-research-worker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/czh/SJTU_Task_final
EnvironmentFile=/home/czh/.config/paper-research/secrets.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env EXPERIMENT_WORKER_ID=paper-experiment-worker-%i E2B_GLOBAL_CONCURRENCY=8 /home/czh/SJTU_Task_final/.venv/bin/python -m paper_research.main experiment-worker
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
